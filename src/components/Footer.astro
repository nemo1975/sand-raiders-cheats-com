---
import { t } from '../i18n';
import { DISCORD_INVITE, SITE_URL } from '../config/site';
import { isExternalHref } from '../utils/path';
import { Separator } from '@/components/starwind/separator';

const shareUrl = encodeURIComponent(`${SITE_URL}/`);
const resourceLinks = [
  { href: '/blog/', label: 'Sand Raiders guides', ariaLabel: 'Sand Raiders guides' },
  { href: '/esp/', label: 'Player ESP guide', ariaLabel: 'Player ESP guide' },
  { href: '/aim/', label: 'Sand Raiders aimbot', ariaLabel: 'Sand Raiders aimbot' },
  { href: '/radar/', label: 'Radar features', ariaLabel: 'Radar features' },
  { href: '/ac/', label: 'Sand Raiders anti-cheat', ariaLabel: 'Sand Raiders anti-cheat' },
  { href: '/early-access/', label: 'When did SAND: Raiders of Sophie come out', ariaLabel: 'When did SAND: Raiders of Sophie come out' },
  { href: '/squad/', label: 'Is SAND: Raiders of Sophie cross platform', ariaLabel: 'Is SAND: Raiders of Sophie cross platform' },
  { href: '/dma/', label: 'Cloud DMA', ariaLabel: 'Cloud DMA' },
  { href: '/hwid/', label: 'HWID Spoofer', ariaLabel: 'HWID Spoofer' },
  { href: '/skin-changer/', label: 'Skin Changer', ariaLabel: 'SAND skin changer' },
  { href: '/forum/', label: 'Sand Raiders community vs this forum', ariaLabel: 'Community forum' },
  { href: '/publisher/', label: 'Publisher and developer names', ariaLabel: 'tinyBuild and Hologryph naming' },
  { href: DISCORD_INVITE, label: t.footer.support },
];

const popularSearches = [
  { href: '/', label: 'SAND: Raiders of Sophie' },
  { href: '/early-access/', label: 'SAND: Raiders of Sophie' },
  { href: '/publisher/', label: 'SAND publisher' },
  { href: '/tramplers/', label: 'Tramplers and raiders' },
  { href: '/roadmap/', label: 'SAND Early Access updates' },
  { href: '/storm-dive/', label: 'Storm Dive and Voyage' },
  { href: '/sophie/', label: 'Planet Sophie' },
  { href: '/voyage/', label: 'Voyage Mode' },
  { href: '/tramplers/', label: 'Trampler guide' },
  { href: '/blueprints/', label: 'Trampler blueprints' },
  { href: '/weapons/', label: 'Weapons and loot' },
  { href: '/early-access/', label: 'SAND: Raiders of Sophie download' },
];

const legalLinks = [
  { href: '/about/', label: t.footer.about },
  { href: '/privacy/', label: t.footer.privacy },
  { href: '/terms/', label: t.footer.terms },
];
---

<footer class="border-t border-border bg-muted/30 py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <a href="/" class="inline-flex items-center font-[family-name:var(--font-heading)] text-lg font-bold">
          <span>Sand Raiders<span class="text-primary">Cheats</span></span>
        </a>
        <p class="text-sm text-muted-foreground">{t.footer.tagline}</p>
      </div>

      <nav aria-label={t.footer.explore}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.explore}</p>
        <ul class="mt-3 space-y-2">
          {t.footer.exploreLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-flex min-h-12 items-center text-sm text-muted-foreground hover:text-primary"
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.support}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.support}</p>
        <ul class="mt-3 space-y-2">
          {resourceLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-flex min-h-12 items-center text-sm text-muted-foreground hover:text-primary"
                {...(isExternalHref(link.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.legal}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.legal}</p>
        <ul class="mt-3 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="inline-flex min-h-12 items-center text-sm text-muted-foreground hover:text-primary">{link.label}</a>
            </li>
          ))}
          <li>
            <a
              href="https://store.steampowered.com/app/1431300/SAND_Raiders_of_Sophie/"
              class="inline-flex min-h-12 items-center text-sm text-muted-foreground hover:text-primary"
            >
              SAND: Raiders of Sophie on Steam
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <Separator class="my-8" />
    <nav aria-label="Popular SAND: Raiders of Sophie searches" class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Popular SAND: Raiders of Sophie searches</p>
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
        {popularSearches.map((link) => (
          <li>
            <a href={link.href} class="inline-flex min-h-12 items-center text-sm text-muted-foreground hover:text-primary">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-left text-sm text-muted-foreground">
        &copy; {new Date().getFullYear()} {t.site.name} · {t.site.domain}
      </p>
      <nav aria-label="Share Sand Raiders Cheats" class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
        <a
          class="inline-flex min-h-12 items-center text-muted-foreground hover:text-primary"
          href={`https://x.com/intent/post?url=${shareUrl}&text=${encodeURIComponent('Sand Raiders Cheats')}`}
        >
          Share on X
        </a>
        <a
          class="inline-flex min-h-12 items-center text-muted-foreground hover:text-primary"
          href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`}
        >
          Share on Facebook
        </a>
      </nav>
    </div>
  </div>
</footer>
