---
import { t } from '../i18n';
import { getFeaturedBlogPosts } from '../data/blog';
import WorkflowSection from './WorkflowSection.astro';
import SectionHeader from './SectionHeader.astro';
import BlogCard from './BlogCard.astro';
import Icon from './icons/Icon.astro';
import { ROUTES } from '../utils/path';
import SiteFaqSection from './SiteFaqSection.astro';
import { getLandingFaqs } from '../data/faq';
import { Button } from '@/components/starwind/button';

const homeFaqs = getLandingFaqs();
const featuredPosts = getFeaturedBlogPosts(3);
---

<WorkflowSection />

<section id="blog" class="border-y border-border bg-muted/20 py-16 md:py-24" aria-labelledby="blog-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader as="h2" eyebrow={t.blog.eyebrow} title={t.blog.title} desc={t.blog.subtitle} titleId="blog-title" />

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-10">
      {featuredPosts.map((post, i) => (
        <BlogCard post={post} index={i} />
      ))}
    </div>

    <div class="mt-10 flex flex-wrap justify-start gap-3 lg:justify-center">
      <Button as="a" href={ROUTES.blog} variant="outline">
        {t.blog.viewAll}
        <Icon name="arrowRight" size={17} />
      </Button>
      <Button as="a" href={ROUTES.forum} variant="outline">
        Open forum
      </Button>
      <Button as="a" href={ROUTES.store} variant="outline">
        View store
      </Button>
    </div>
  </div>
</section>

<nav class="border-y border-border bg-muted/10 py-12 md:py-16" aria-label="Explore Sand Raiders Cheats">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      as="h2"
      eyebrow="Explore"
      title="Every Sand Raiders Cheats page stays one click away"
      desc="Sand Raiders of Sophie cheats pages: hacks guides, cheat codes meaning, trainer searches, store plans, setup, status, Tramplers, and BattlEye notes."
      titleId="explore-title"
    />
    <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { href: ROUTES.features, title: 'Sand Raiders of Sophie cheats & features', desc: 'Hacks modules: aimbot, player ESP, radar, Trampler ESP.' },
        { href: '/cheats/', title: 'Sand Raiders of Sophie Cheats guide', desc: 'Module map before you open the store.' },
        { href: '/cheat-codes/', title: 'Sand Raiders cheat codes', desc: 'Why PC searches rarely mean typed codes.' },
        { href: '/hacks/', title: 'Sand Raiders of Sophie hacks', desc: 'ESP, wallhack, and radar terminology.' },
        { href: '/trainer/', title: 'Sand Raiders of Sophie trainer', desc: 'Trainer searches vs overlay toggles.' },
        { href: ROUTES.store, title: 'Sand Raiders Cheats store', desc: 'Monthly $35 and lifetime $150 plans.' },
        { href: ROUTES.dma, title: 'Cloud DMA', desc: 'Extra that runs with Sand Raiders Cheats.' },
        { href: ROUTES.hwid, title: 'HWID Spoofer', desc: 'Extra that runs with Sand Raiders Cheats.' },
        { href: ROUTES.skinChanger, title: 'Skin Changer', desc: 'Blueprint and cosmetic previews for SAND.' },
        { href: '/early-access/', title: 'Early Access on Steam', desc: 'Launch date, download, and Steam requirements.' },
        { href: '/tramplers/', title: 'Tramplers', desc: 'Walker editor, blueprints, and Trampler ESP.' },
        { href: '/roadmap/', title: 'Early Access roadmap', desc: 'Steam updates and status re-checks.' },
        { href: '/storm-dive/', title: 'Storm Dive vs Voyage', desc: 'Mode pacing and overlay ranges.' },
        { href: '/sophie/', title: 'Planet Sophie', desc: 'Dieselpunk setting and lore context.' },
        { href: '/voyage/', title: 'Voyage Mode', desc: 'Low-pressure expeditions for testing overlays.' },
        { href: '/blueprints/', title: 'Trampler blueprints', desc: 'Saved builds—not cheat modules.' },
        { href: '/weapons/', title: 'Weapons and loot', desc: 'Loadouts vs the store feature list.' },
        { href: '/squad/', title: 'Squad vs solo', desc: 'Team check filters and crew roles.' },
        { href: '/publisher/', title: 'Publisher names', desc: 'tinyBuild, Hologryph, TowerHaus—no affiliation.' },
        { href: '/esp/', title: 'Player ESP', desc: 'Box, skeleton, health, and distance.' },
        { href: '/aim/', title: 'Sand Raiders aimbot', desc: 'Aim assist, silent aim, triggerbot.' },
      ].map((item) => (
        <li>
          <a
            href={item.href}
            class="block h-full rounded-2xl border border-border bg-card/80 px-4 py-4 transition-colors hover:border-primary/40"
          >
            <p class="font-semibold text-foreground">{item.title}</p>
            <p class="mt-1 text-sm text-muted-foreground">{item.desc}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<SiteFaqSection id="faq" titleId="faq-title" items={homeFaqs} />
